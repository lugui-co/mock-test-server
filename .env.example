# Copie para .env (não versionado). Todas são opcionais: vazio = default de src/config/config.ts.
PORT=                    # default 3006
NODE_ENV=                # development | production (production também grava logs em LOG_DIR)
JWT_SECRET=              # chave HMAC dos tokens; use um valor qualquer local, nunca um segredo real
TOKEN_EXPIRY=            # segundos, default 3600
RATE_LIMIT_WINDOW_MS=    # default 900000 (15 min)
RATE_LIMIT_MAX_REQUESTS= # default 100 por IP na janela (conta /health)
LOG_LEVEL=               # default info
LOG_DIR=                 # default logs
MIN_DELAY=               # ms, default 2000; use 0 para desenvolvimento rápido
MAX_DELAY=               # ms, default 60000; use 0 para desenvolvimento rápido
ERROR_CHANCE_PERCENT=    # 0-100, default 15; use 0 para desligar erros aleatórios
